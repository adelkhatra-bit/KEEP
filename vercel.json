{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "cd packages/mobile && npx expo export --platform web && node scripts/fix-web-export.cjs dist",
  "outputDirectory": "packages/mobile/dist",
  "cleanUrls": true,
  "env": {
    "EXPO_PUBLIC_DEMO_MODE": "true",
    "EXPO_PUBLIC_KEEP_PREVIEW": "1"
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
