# Backend Environment Variables — copie ce fichier en .env et renseigne de
# vraies valeurs. Ne JAMAIS committer .env/.env.local.

# Supabase — utilisé par src/lib/supabaseTokenVerifier.ts pour valider les
# sessions KEEP (route /api/music/apple/developer-token). Sans ces deux
# variables, cette route reste désactivée (503) plutôt que non protégée.
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# API
PORT=3000
NODE_ENV=development

# MusicKit Apple (developer token, JAMAIS dans l'app mobile) — voir
# src/lib/appleDeveloperToken.ts et docs/DEPLOYMENT_TESTFLIGHT.md pour où
# obtenir ces 3 valeurs (compte Apple Developer -> MusicKit).
APPLE_MUSICKIT_TEAM_ID=your_apple_team_id
APPLE_MUSICKIT_KEY_ID=your_musickit_key_id
APPLE_MUSICKIT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Authentification & Admin
KEEP_INTERNAL_ADMIN_KEY=your_internal_admin_key

# URLs & Public endpoints
PUBLIC_BACKEND_URL=http://localhost:3000
KEEP_WEB_URL=http://localhost:3001
PUBLIC_WEB_URL=http://localhost:3001
MUSIC_OAUTH_STATE_SECRET=your_music_oauth_state_secret

# Email (Brevo SMTP)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=your_brevo_smtp_login
BREVO_SMTP_KEY=your_brevo_smtp_key
BREVO_SENDER_EMAIL=noreply@loki.app
BREVO_SENDER_NAME=Loki
BREVO_API_KEY=your_brevo_api_key

# Email (Mailjet - alternative)
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key

# Spotify
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Deezer
DEEZER_APP_ID=your_deezer_app_id
DEEZER_APP_SECRET=your_deezer_app_secret

# YouTube
YOUTUBE_API_KEY=your_youtube_api_key

# Music Recognition (CRITICAL for Listen feature)
AUDD_API_KEY=your_audd_api_key
ACRCLOUD_ACCESS_KEY=your_acrcloud_access_key
ACRCLOUD_ACCESS_SECRET=your_acrcloud_access_secret
ACRCLOUD_HOST=your_acrcloud_host

# Payments
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
PADDLE_SELLER_ID=your_paddle_seller_id
PADDLE_CLIENT_TOKEN=your_paddle_client_token
PADDLE_API_KEY=your_paddle_api_key
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret