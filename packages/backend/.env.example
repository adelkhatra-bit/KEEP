# Backend Environment Variables — copie ce fichier en .env et renseigne de
# vraies valeurs. Ne JAMAIS committer .env/.env.local.

# Supabase — utilisé par src/lib/supabaseTokenVerifier.ts pour valider les
# sessions KEEP (route /api/music/apple/developer-token). Sans ces deux
# variables, cette route reste désactivée (503) plutôt que non protégée.
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
# service_role -- SERVEUR UNIQUEMENT, jamais mobile/admin web (voir
# routes/admin.ts et routes/social.ts). Dashboard Supabase -> Project
# Settings -> API -> service_role (secret, pas la clé "anon"/"publishable").
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# API
PORT=3000
NODE_ENV=development
# CORS -- CSV des origines autorisées (ex. https://app.keep.com,https://admin.keep.com).
# Vide en dev = origine libre (tunnels mobiles à origine changeante).
# Vide + NODE_ENV=production = aucune origine cross-site autorisée (jamais un repli permissif).
ALLOWED_ORIGINS=

# MusicKit Apple (developer token, JAMAIS dans l'app mobile) — voir
# src/lib/appleDeveloperToken.ts et docs/DEPLOYMENT_TESTFLIGHT.md pour où
# obtenir ces 3 valeurs (compte Apple Developer -> MusicKit).
APPLE_MUSICKIT_TEAM_ID=your_apple_team_id
APPLE_MUSICKIT_KEY_ID=your_musickit_key_id
APPLE_MUSICKIT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# AcoustID (reconnaissance GRATUITE, en amont d'AudD) — clé gratuite à créer
# sur acoustid.org/new-application (compte gratuit, usage non-commercial ;
# passage payant seulement à l'échelle, voir acoustid.biz). Nécessite AUSSI
# le binaire `fpcalc` installé sur cette machine (apt install
# libchromaprint-tools / brew install chromaprint / choco install
# chromaprint) — voir src/lib/acoustId.ts. Sans l'un des deux, l'endpoint
# répond honnêtement 501, jamais un faux résultat.
ACOUSTID_API_KEY=your_acoustid_api_key

# KEEP Local Index (gratuit, audfprint MIT -- github.com/dpwe/audfprint,
# licence vérifiée le 23/08/2026) -- reconnaissance locale des morceaux déjà
# confirmés une fois par KEEP, zéro appel réseau/coût. Absent = étape
# sautée, repli automatique sur AcoustID, jamais une erreur bloquante. Voir
# packages/recognition-engine/README.md pour l'installation locale.
KEEP_AUDFPRINT_PYTHON=/absolute/path/to/packages/recognition-engine/.venv/bin/python
KEEP_AUDFPRINT_SCRIPT=/absolute/path/to/packages/recognition-engine/audfprint/audfprint.py
# Dossier où vit la base de fingerprints (.pklz) -- grossit avec l'usage,
# ne contient QUE des empreintes/hashes, jamais l'audio source. Défaut : ./data/keep-local-index.
KEEP_LOCAL_INDEX_DIR=
