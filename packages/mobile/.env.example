# KEEP Mobile Environment Variables — copie ce fichier en .env(.local) et
# renseigne de vraies valeurs. Ne JAMAIS committer .env/.env.local.

# Bibliothèque musicale de test. true = playlists locales tant qu'Apple/Spotify
# n'est pas connecté. Cela n'empêche plus la reconnaissance micro réelle.
EXPO_PUBLIC_DEMO_MODE=true

# Reconnaissance micro réelle via la fonction Supabase keep-music-core.
# La clé AudD/ACRCloud reste côté serveur dans Supabase Vault et ne doit JAMAIS
# être mise dans une variable EXPO_PUBLIC_*.
EXPO_PUBLIC_KEEP_REAL_RECOGNITION=true

# API Configuration — nécessaire pour les connexions Apple/Spotify et le backend.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_ENVIRONMENT=development

# Auth / Supabase (clé publishable/anon uniquement, autorisée côté client).
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# URL publique CANONIQUE. Ces deux valeurs ne doivent jamais être remplacées
# par localhost, trycloudflare, Vercel ou une URL de preview temporaire dans un
# build partagé/public. Tous les profils et anciennes redirections convergent ici.
EXPO_PUBLIC_WEB_URL=https://adelkhatra-bit.github.io/KEEP
EXPO_PUBLIC_AUTH_REDIRECT_URL=https://adelkhatra-bit.github.io/KEEP/

# Music Platforms — identifiants publics uniquement. Les secrets privés restent
# dans Supabase Vault / le backend Super Admin.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id
