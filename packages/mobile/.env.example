# KEEP Mobile Environment Variables — copie ce fichier en .env(.local) et
# renseigne de vraies valeurs. Ne JAMAIS committer .env/.env.local (voir
# .gitignore — ces fichiers ont été retirés du suivi git le 2026-08-21).

# Mode Démo — true = vitrine commerciale, aucune écriture réelle en base,
# providers Demo forcés. Passer à false uniquement quand un provider musical
# réel + un backend Supabase réel sont configurés (voir docs/PROJECT_STATUS.md).
EXPO_PUBLIC_DEMO_MODE=true

# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_ENVIRONMENT=development

# Reconnaissance musicale — voir docs/MUSIC_RECOGNITION_PROVIDERS.md pour le
# comparatif de prix qui a guidé ce choix (AudD en primaire, ACRCloud en secours).
EXPO_PUBLIC_AUDD_API_KEY=your_audd_key_here
EXPO_PUBLIC_ACRCLOUD_ACCESS_KEY=your_acrcloud_access_key_here

# Auth / Backend
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Partage web public (packages/backend/src/routes/share.ts) -- sans elle,
# le partage reste réel mais utilise uniquement le deep link keep://
# (fonctionne seulement si le destinataire a déjà KEEP installé).
EXPO_PUBLIC_WEB_URL=your_public_web_url

# Music Platforms
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your_spotify_client_id
