{
  "expo": {
    "name": "KEEP",
    "slug": "keep",
    "owner": "saleme01s-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.adelkhatra.keep",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "KEEP uses your microphone during a session to identify the songs playing around you.",
        "NSLocationWhenInUseUsageDescription": "KEEP can attach an approximate location to a session and show nearby profiles/events in Discover — only if you turn this on in your profile.",
        "NSLocalNetworkUsageDescription": "KEEP needs local network access",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.adelkhatra.keep",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow KEEP to access your photos"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "KEEP can attach an approximate location to a session and show nearby profiles/events in Discover — only if you turn this on in your profile."
        }
      ],
      "expo-notifications",
      "expo-localization",
      "expo-secure-store"
    ],
    "scheme": "keep",
    "extra": {
      "eas": {
        "projectId": "f9598ced-2480-4fa6-8d6e-885dd4e489e8"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f9598ced-2480-4fa6-8d6e-885dd4e489e8"
    }
  }
}
