{
  "expo": {
    "name": "Loki",
    "slug": "keep",
    "owner": "saleme01s-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.adelkhatra.keep",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "KEEP utilise le microphone uniquement pendant une session d’écoute afin d’identifier les morceaux diffusés autour de vous.",
        "NSLocationWhenInUseUsageDescription": "Avec votre accord, KEEP utilise votre position pour préremplir votre ville et votre pays et afficher les profils ou événements à proximité. Vous pouvez ensuite modifier ces informations manuellement.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "package": "com.adelkhatra.keep",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-share-intent",
        {
          "iosShareExtensionName": "KEEPShareExtension",
          "iosHideView": true,
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "androidIntentFilters": [
            "text/*"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KEEP peut accéder à vos photos uniquement lorsque vous choisissez une photo de profil."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Avec votre accord, KEEP utilise votre position pour préremplir votre ville et votre pays et afficher les profils ou événements à proximité. Vous pouvez ensuite modifier ces informations manuellement."
        }
      ],
      "expo-notifications",
      "expo-localization",
      "expo-secure-store"
    ],
    "scheme": "keep",
    "extra": {
      "eas": {
        "projectId": "f9598ced-2480-4fa6-8d6e-885dd4e489e8"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f9598ced-2480-4fa6-8d6e-885dd4e489e8"
    }
  }
}
