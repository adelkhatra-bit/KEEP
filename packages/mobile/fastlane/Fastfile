########################################################################
# Fastfile — Loki Music
#
# Objectif : publier la FICHE App Store et soumettre la v1.0.0 (dernier build TestFlight disponible) de facon 100% AUTONOME, sans aucune action manuelle.
#
# Auth par CLÉ API App Store Connect (JWT), le meme secret qui a deja produit
# un build TestFlight : ASC_API_KEY_P8_BASE64 + ASC_KEY_ID + ASC_ISSUER_ID.
# Aucun mot de passe d'app, aucun clic, aucune session interactive.
#
# Variables d'environnement attendues (fournies par les GitHub Secrets) :
#   ASC_API_KEY_P8_BASE64  -> clé privée .p8 encodée en base64
#   ASC_KEY_ID             -> Key ID (ex: TYJC8LTGVF)
#   ASC_ISSUER_ID          -> Issuer ID (ex: bf75c204-8876-4c83-a84a-52b7e7a5b2c3)
#   APPLE_TEAM_ID          -> defaut WTG9399DBK
#   ASC_APP_ID             -> defaut 6812393589
#
# Repli (si un jour seule une auth Apple ID est disponible) :
#   FASTLANE_USER + FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD
#
# Lanes :
#   fastlane ios listing   -> remplit la fiche SANS soumettre (verif)
#   fastlane ios submit    -> remplit la fiche ET soumet a la review (autonome)
#   fastlane ios validate  -> controle la conformite de la fiche
########################################################################

default_platform(:ios)

platform :ios do
  # Construit un token App Store Connect a partir des secrets deja presents.
  # Retourne true si la cle API a pu etre chargee, false sinon.
  def load_asc_api_key
    return false if ENV["ASC_API_KEY_P8_BASE64"].to_s.empty?
    return false if ENV["ASC_KEY_ID"].to_s.empty?
    return false if ENV["ASC_ISSUER_ID"].to_s.empty?
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_API_KEY_P8_BASE64"],
      is_key_content_base64: true,
      in_house: false
    )
    true
  end

  before_all do
    has_api_key = load_asc_api_key
    unless has_api_key
      # Repli Apple ID uniquement si la cle API n'est pas disponible.
      if ENV["FASTLANE_USER"].to_s.empty? || ENV["FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD"].to_s.empty?
        UI.user_error!(
          "Auth Apple absente : fournir ASC_API_KEY_P8_BASE64 + ASC_KEY_ID + ASC_ISSUER_ID " \
          "(mode 100% autonome) OU FASTLANE_USER + FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD. " \
          "Voir docs/APP_STORE_VOCAL_GUIDE.md"
        )
      end
    end
  end

  desc "Remplit la fiche App Store (metadonnees + screenshots) SANS soumettre"
  lane :listing do
    deliver(
      submit_for_review: false,
      skip_binary_upload: true,
      force: true,
      run_precheck_before_submit: false
    )
    UI.success("Fiche App Store mise a jour. Verifie dans App Store Connect, puis lance `fastlane ios submit`.")
  end

  desc "Remplit la fiche ET soumet le dernier build TestFlight de la v1.0.0 a la review Apple"
  lane :submit do
    version = ENV["ASC_APP_VERSION"].to_s.empty? ? "1.0.0" : ENV["ASC_APP_VERSION"]
    build = latest_testflight_build_number(
      version: version,
      initial_build_number: 1
    )
    UI.message("Soumission du dernier build TestFlight disponible : #{version} (#{build})")
    deliver(
      app_version: version,
      build_number: build,
      submit_for_review: true,
      skip_binary_upload: true,
      force: true,
      automatic_release: true,
      run_precheck_before_submit: true
    )
    UI.success("Loki Music #{version} (build #{build}) soumise a la review App Store.")
  end

  desc "Controle la conformite de la fiche avant soumission"
  lane :validate do
    precheck
  end
end
