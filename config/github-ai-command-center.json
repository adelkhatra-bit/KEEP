  "ciArchitecture": {
    "pipeline": [
      "DIFF",
      "MODULE_AFFECTE",
      "DEPENDANCES",
      "TESTS_CIBLES",
      "BUILD_CIBLE",
      "TEST_NAVIGATEUR",
      "PUBLICATION"
    ],
    "standardOutputFields": [
