      "FICHIERS MODIFIÉS",
      "TESTS LANCÉS",
      "TESTS NON NÉCESSAIRES",
      "SHA",
      "VERSION WEB TESTÉE",
      "DESKTOP",
      "390×844",
      "DÉPLOIEMENT",
      "ERREURS RESTANTES"
    ],
    "levels": {
      "LOCAL_TARGETED": "Lint/typecheck du périmètre + tests du module touché.",
      "INTEGRATION": "Module touché + consommateurs directs quand une dépendance partagée change.",
      "GLOBAL": "Réservé aux releases, builds natifs, navigation globale, SHARED_CORE critique, grosses migrations et déclenchements manuels."
    },
    "webDeploymentRules": [
      "Documentation seule → aucun rebuild application.",
      "Workflow CI seul → aucun rebuild application.",
      "Tests seuls → aucun rebuild production.",
      "Code mobile/web impactant le runtime → build web ciblé + preview + test navigateur réel.",
      "Ne jamais reconstruire une seconde fois exactement le même SHA uniquement pour le promouvoir."
