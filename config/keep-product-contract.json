    "recentArtistMemory": 240,
    "chansonFrDeepBudget": 4000,
    "frenchNamedArtistBootstrapMinimum": 120,
    "preferUnseenTracksAndArtists": true,
    "serverSideExpansion": true,
    "catalogExpansionWithoutAppRelease": true,
    "providerRateLimitedBatches": true
  },
  "marketplacePurchases": {
    "completedPurchaseMustPersistInBuyerPlaylist": true,
    "completedPurchaseMustPersistKeepDecision": true,
    "recentPurchasesLocation": "Playlists home / Derniers achats",
    "recentPurchasesMustRemainAccessibleWhenMarketplaceVisibilityIsOff": true,
    "previewMustKeepTrackMetadataHiddenUntilUnlock": true,
    "previewMustShowOwnedVsMissingCounts": true,
    "previewMustExposeSellerProfile": true,
    "previewMustUse3DProtectedMysteryVisual": true,
    "duplicateDeliveryMustBeIdempotent": true,
    "partialMissingTrackRequest": true,
