  "responsive": {
    "requiredViewports": ["390x844", "430x932", "768x700", "900x700", "1440x900"],
    "desktopRootMustFillViewport": true,
    "resizeMustNotBlankApplication": true,
    "fiveTabsMustRemainVisible": true
  },
  "changeProtocol": {
    "auditBeforeEdit": true,
    "checkRemoteHeadBeforeEdit": true,
    "checkLiveSupabaseBeforeChangingDataRelatedUI": true,
    "updateContractAndGuardsInSameCommitWhenAProductRuleChanges": true,
    "neverFixUiByMutatingProductionUserData": true,
    "cleanGeneratedCachesBeforeIntegration": true,
    "validatedProductRulesImmutableUntilExplicitUserChange": true,
    "integrationPreflightCommand": "npm run integration:preflight",
