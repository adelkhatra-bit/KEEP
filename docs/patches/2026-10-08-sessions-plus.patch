@@ -0,0 +1,23 @@
+import { pendingSessionSummary } from '../pendingSessionSummary';
+const session = (id: string, statuses: string[]) => ({ id, tracks: statuses.map(status => ({ status })) });
+describe('pending session badge', () => {
+  it('survives archive and reopening with an empty live buffer', () => {
+    expect(pendingSessionSummary([session('saved', ['pending'])])).toEqual({ sessions: 1, tracks: 1 });
+  });
+  it('counts sessions separately from tracks and excludes resolved entries', () => {
+    expect(pendingSessionSummary([session('a', ['pending', 'pending', 'kept']), session('b', ['passed'])]))
+      .toEqual({ sessions: 1, tracks: 2 });
+  });
+  it('prefers the current state over its stale persisted snapshot', () => {
+    expect(pendingSessionSummary([session('a', ['pending'])], session('a', ['kept'])))
+      .toEqual({ sessions: 0, tracks: 0 });
+  });
+  it('counts an unarchived active session once', () => {
+    expect(pendingSessionSummary([], session('live', ['pending']))).toEqual({ sessions: 1, tracks: 1 });
+  });
+  it('does not modify the history while counting', () => {
+    const history = [session('a', ['pending'])]; const before = JSON.stringify(history);
+    pendingSessionSummary(history, session('a', ['passed']));
+    expect(JSON.stringify(history)).toBe(before);
+  });
+});
