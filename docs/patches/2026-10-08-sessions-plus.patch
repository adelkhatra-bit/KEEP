@@ -0,0 +1,19 @@
+type PendingTrack = { status: string };
+type PendingSession = { id: string; tracks: readonly PendingTrack[] };
+
+/** Count unresolved sessions, never the current detection buffer alone. */
+export function pendingSessionSummary(
+  history: readonly PendingSession[],
+  active: PendingSession | null = null,
+): { sessions: number; tracks: number } {
+  const byId = new Map(history.map((session) => [session.id, session]));
+  // The live state is newer than its persisted snapshot; count it once.
+  if (active) byId.set(active.id, active);
+  let sessions = 0;
+  let tracks = 0;
+  for (const session of byId.values()) {
+    const pending = session.tracks.filter((track) => track.status === 'pending').length;
+    if (pending > 0) { sessions += 1; tracks += pending; }
+  }
+  return { sessions, tracks };
+}
